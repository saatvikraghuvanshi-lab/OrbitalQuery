[TEMPLATE]
# ── OrbitalQuery EO Analysis Service ──────────────────────────
# Copy this to .env and fill in values.

# STAC API endpoint (Microsoft Planetary Computer)
STAC_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# Default STAC collection for searches
DEFAULT_COLLECTION=sentinel-2-l2a

# Default maximum cloud cover filter (0-100)
DEFAULT_MAX_CLOUD_COVER=30

# Default number of results to return
DEFAULT_LIMIT=10

# Server host and port
HOST=0.0.0.0
PORT=8000

# ── Optional Providers ───────────────────────────────────────

# Copernicus Data Space Ecosystem (optional — increases rate limits)
COPERNICUS_TOKEN=

# Bhoonidhi / ISRO (required to enable ISRO data access)
# Sign up at: https://bhoonidhi.nrsc.gov.in
# Get API docs at: https://bhoonidhi.nrsc.gov.in/bhoonidhi-api/
BHOONIDHI_USER=Orbital2026
BHOONIDHI_PASS=Ft!Orbital2026#
