# ═══════════════════════════════════════════════════════════
# OrbitalQuery — Environment Variables
# ═══════════════════════════════════════════════════════════
#
# Copy this file to backend/.env and frontend/.env.local
# No API keys required for local development with SQLite!
# The app works out of the box with sample data.
#
# ═══════════════════════════════════════════════════════════

# ─── Backend (.env) ──────────────────────────────────────

# Server port
PORT=3001

# Frontend origin for CORS (must match frontend URL)
CORS_ORIGIN=http://localhost:3000

# Planetary Computer STAC API (free, no key needed)
# Used for live data ingestion — not required for local dev
STAC_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# FAISS/TF-IDF index storage path
FAISS_INDEX_PATH=./data/faiss_index

# JWT Secret — change this in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-random-secret-in-production

# ─── Frontend (.env.local) ───────────────────────────────

# Backend API URL (leave empty to use Next.js proxy on localhost:3001)
NEXT_PUBLIC_API_URL=

# Mock mode: set to "true" to use mock data without backend
NEXT_PUBLIC_USE_MOCKS=false

# Backend URL for direct API calls
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# ─── Optional: External APIs ─────────────────────────────
#
# These are NOT required for local development.
# The app works with SQLite + sample data out of the box.
#
# If you want to ingest LIVE data from STAC APIs, just run:
#   curl -X POST http://localhost:3001/api/ingest/planetary-computer \
#     -H "Content-Type: application/json" \
#     -H "Authorization: Bearer YOUR_JWT_TOKEN" \
#     -d '{"collections":["sentinel-2-l2a"], "maxItems":100}'
#
# No API keys needed! Planetary Computer STAC API is free and open.
#
# NASA Earthdata (optional, for additional datasets):
#   Sign up at: https://urs.earthdata.nasa.gov/
#   EARTHDATA_CLIENT_ID=""
#
# Copernicus (optional, for additional datasets):
#   Register at: https://scihub.copernicus.eu/
#   COPERNICUS_USER=""
#   COPERNICUS_PASSWORD=""
