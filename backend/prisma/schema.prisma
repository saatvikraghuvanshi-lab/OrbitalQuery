generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("researcher")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model EODataset {
  id          String   @id @default(uuid())
  stacId      String?  @unique @map("stac_id")
  title       String
  description String?
  provider    String
  collection  String?
  platform    String?
  instrument  String?
  gsd         Float?
  cloudCover  Float?   @map("cloud_cover")
  geometry    String
  bbox        String?
  centroidLat Float?   @map("centroid_lat")
  centroidLng Float?   @map("centroid_lng")
  startDate   String?  @map("start_date")
  endDate     String?  @map("end_date")
  assets      String?
  stacLink    String?  @map("stac_link")
  previewUrl  String?  @map("preview_url")
  capabilities String?  // JSON: phenomena, analysis types, bands, indices
  temporalRes String?  @map("temporal_res")  // e.g. "5 days", "16 days", "daily"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  hasEmbedding Boolean @default(false) @map("has_embedding")
  embeddingId  Int?    @map("embedding_id")

  @@index([provider])
  @@index([collection])
  @@map("eo_datasets")
}

model SearchLog {
  id          String   @id @default(uuid())
  query       String
  filters     String?
  resultCount Int      @map("result_count")
  latencyMs   Int      @map("latency_ms")
  userId      String?  @map("user_id")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("search_logs")
}
